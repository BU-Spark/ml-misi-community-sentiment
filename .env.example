# Example environment configuration for ml-misi-community-sentiment
#
# Copy this file to .env at the repo root and fill in values.
# IMPORTANT: Never commit real secrets (API keys, OAuth secrets, etc.).
#
# ----------------------------------------------------------------------------
# Gemini AI Configuration
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_SUMMARY_MODEL=gemini-3-flash-preview

# Embedding model for vector search (RAG)
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# ----------------------------------------------------------------------------
# API / OAuth / Flask configuration
# ----------------------------------------------------------------------------
# Legacy-only API-key compatibility (optional)
RETHINKAI_API_KEYS=

API_HOST=127.0.0.1
API_PORT=8888

APP_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8888
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8888/auth/google/callback

FLASK_SECRET_KEY=change-me
FLASK_SESSION_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# MySQL Database Configuration (311, 911, events)
# ----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_pass
MYSQL_DB=sentiment_demo

# ----------------------------------------------------------------------------
# Vector Database Configuration
# ----------------------------------------------------------------------------
# Path to ChromaDB vector database directory (used by data_ingestion, relative to on_the_porch/data_ingestion)
VECTORDB_DIR=../vectordb_new

# ----------------------------------------------------------------------------
# LangChain / LangSmith Tracing (Optional)
# ----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=rethinkai-community-sentiment
LANGSMITH_PROJECT=rethinkai-community-sentiment

# ----------------------------------------------------------------------------
# Data Ingestion (Google Drive + Email)
# ----------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_PATH=

NEWSLETTER_EMAIL_ADDRESS=
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

TEMP_DOWNLOAD_DIR=./temp_downloads
EMAIL_LOOKBACK_DAYS=7
MAX_FILES_PER_RUN=100
VERBOSE_LOGGING=true

# ----------------------------------------------------------------------------
# Admin
# ----------------------------------------------------------------------------
AUTH_ADMIN_EMAILS=

